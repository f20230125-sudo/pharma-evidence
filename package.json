{
  "name": "pharma-evidence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prepare-model.mjs && node scripts/build-worker.mjs",
    "dev": "next dev -p 3070",
    "build": "next build",
    "start": "next start -p 3070",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "data": "python pipeline/build.py",
    "evaluate": "node scripts/evaluate.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.8",
    "@huggingface/transformers": "4.3.1",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
